{
  "name": "portfolio-cv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:dump-seed": "tsx scripts/dump-db-seed.ts",
    "db:sync-seed": "npm run db:dump-seed && npm run build:content",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build:content": "tsx scripts/build-content.ts",
    "generate:resume-variants": "node scripts/generate-resume-variants.mjs",
    "build:resumes": "tsx scripts/build-resumes.ts",
    "build:static-html": "tsx scripts/build-static-html.ts",
    "linkedin:auth": "tsx scripts/linkedin-auth.ts",
    "sync:linkedin": "tsx scripts/sync-linkedin.ts",
    "upwork:auth": "tsx scripts/upwork-auth.ts",
    "sync:upwork": "tsx scripts/sync-upwork.ts",
    "sync:github-projects": "tsx scripts/sync-github-projects.ts",
    "sync:project-assets": "tsx scripts/sync-project-assets.ts",
    "sync:github-activity": "node scripts/sync-github-activity.mjs",
    "gh:secrets": "node scripts/gh-secrets-push.mjs",
    "build": "npm run build:content && npm run build:resumes && tsc -b && vite build && npm run prerender",
    "prerender": "tsx scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "push": "git pull --rebase --autostash && git push",
    "audit:content": "tsx scripts/audit-seo-ats.ts",
    "jd": "tsx scripts/jd/cli.ts",
    "test": "node --import tsx --test scripts/tests/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "animejs": "^4.5.0",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "zod": "^3.25.76"
  }
}
