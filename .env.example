# =============================================================================
# Portfolio / CV — external integrations
# Copy to `.env` and fill in values. Never commit `.env`.
# Setup guide: EXTERNAL.md
# =============================================================================

# -----------------------------------------------------------------------------
# LinkedIn API (OAuth 2.0 + OpenID Connect)
# Developer portal: https://www.linkedin.com/developers/apps
# -----------------------------------------------------------------------------

# App credentials (Auth tab → Application credentials)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match a Redirect URL registered on the app (Auth tab)
LINKEDIN_REDIRECT_URI=http://localhost:8787/auth/linkedin/callback

# OAuth scopes (space-separated). Self-serve baseline:
#   openid profile email
# Add when your app is approved:
#   r_member_social          — read your posts/articles (restricted; see EXTERNAL.md)
#   r_profile_basicinfo      — Verified on LinkedIn Plus tier
#   r_primary_current_experience
#   r_most_recent_education
LINKEDIN_SCOPES=openid profile email

# Tokens obtained after the first OAuth flow (scripts/linkedin-auth.ts)
# Access tokens expire in ~60 days; use refresh token to renew.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=

# Member URN for Posts API (urn:li:person:XXXXXXXX). Filled after auth from `sub`.
LINKEDIN_MEMBER_URN=

# Public vanity slug (linkedin.com/in/<vanity>). Used to build profile URL in site_profile.
LINKEDIN_VANITY_NAME=

# -----------------------------------------------------------------------------
# LinkedIn API runtime
# -----------------------------------------------------------------------------

LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_OAUTH_BASE_URL=https://www.linkedin.com/oauth/v2
LINKEDIN_OIDC_DISCOVERY_URL=https://www.linkedin.com/oauth/.well-known/openid-configuration

# REST API version header (YYYYMM). Check LinkedIn docs for the current version.
LINKEDIN_API_VERSION=202509

# Local callback server port for one-time OAuth (linkedin-auth script)
LINKEDIN_AUTH_LISTEN_PORT=8787

# -----------------------------------------------------------------------------
# Sync behaviour (scripts/sync-linkedin.ts)
# -----------------------------------------------------------------------------

# Where raw API payloads are written before mapping into portfolio.db
LINKEDIN_SNAPSHOT_DIR=data/linkedin

# Toggle fetches (set false to skip sections your app lacks permission for)
LINKEDIN_SYNC_PROFILE=true
LINKEDIN_SYNC_ARTICLES=true
LINKEDIN_SYNC_EXPERIENCE=true
LINKEDIN_SYNC_EDUCATION=true
LINKEDIN_SYNC_SKILLS=true
LINKEDIN_SYNC_CERTIFICATIONS=true

# Posts / articles pagination (max 100 per LinkedIn API request)
LINKEDIN_ARTICLES_PAGE_SIZE=50

# Optional: path to LinkedIn “Get a copy of your data” ZIP export for full CV import
# Settings → Data privacy → Get a copy of your data → Larger data archive
LINKEDIN_DATA_EXPORT_PATH=

# -----------------------------------------------------------------------------
# Upwork API (OAuth 2.0 + GraphQL) — push portfolio → Upwork profile
# Developer portal: https://www.upwork.com/developer
# Setup guide: EXTERNAL.md §Upwork
# -----------------------------------------------------------------------------

# App credentials (API Center → request OAuth 2.0 key)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# Must match a Redirect URL registered on the app
UPWORK_REDIRECT_URI=http://localhost:8788/auth/upwork/callback

# OAuth scopes (space-separated). Requires API key permission:
#   "Freelancer Profile - Read And Write Access"
UPWORK_SCOPES=openid profile email profiles:read

# Tokens obtained after the first OAuth flow (scripts/upwork-auth.ts)
# Access tokens expire in ~24h; refresh token in ~2 weeks.
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
UPWORK_TOKEN_EXPIRES_AT=

UPWORK_API_URL=https://api.upwork.com/graphql
UPWORK_OAUTH_AUTHORIZE_URL=https://www.upwork.com/ab/account-security/oauth2/authorize
UPWORK_OAUTH_TOKEN_URL=https://www.upwork.com/api/v3/oauth2/token
UPWORK_AUTH_LISTEN_PORT=8788

# Local state directory (sync-state.json, last-sync.json — gitignored)
UPWORK_STATE_DIR=data/upwork

# Sync toggles (scripts/sync-upwork.ts)
UPWORK_SYNC_EXPERIENCE=true
UPWORK_SYNC_PROJECTS=true

# Location defaults when portfolio location is missing or only has city/state
UPWORK_DEFAULT_CITY=Your City
UPWORK_DEFAULT_COUNTRY=Brazil

# Projects are pushed as Upwork "other experience" entries (no portfolio write API)
UPWORK_PROJECT_SUBJECT_PREFIX=Portfolio project
UPWORK_INCLUDE_PRIVATE_REPOS=false
UPWORK_FEATURED_PROJECTS_ONLY=false

# -----------------------------------------------------------------------------
# Vercel (production deploy via GitHub Actions)
# Setup: VERCEL.md
# -----------------------------------------------------------------------------

# Token: https://vercel.com/account/tokens
VERCEL_TOKEN=
## 
# Optional in .env — auto-read from .vercel/project.json after `npx vercel link`
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# -----------------------------------------------------------------------------
# GitHub API (contribution heatmap + private repo sync)
# Create token: https://github.com/settings/tokens
# Scopes: repo (private contributions), read:user
# Pushed to GitHub Actions as GH_CONTRIBUTIONS_TOKEN via: npm run gh:secrets
# -----------------------------------------------------------------------------

GITHUB_TOKEN=
GITHUB_USERNAME=your-username

# Asset base path for Vite (e.g. `/` on Vercel, `/repo-name/` on GitHub Pages subpaths).
# Pushed to GitHub Actions as VITE_BASE_PATH via: npm run gh:secrets
VITE_BASE_PATH=

# -----------------------------------------------------------------------------
# Umami analytics (production builds only — not loaded in `npm run dev`)
# Account: Umami Cloud https://cloud.umami.is (free tier) or self-hosted
#          (docker compose / your server)
# Setup walkthrough: `deploy-setup` skill, Step 3 (Umami analytics)
# Docs: https://umami.is/docs
# -----------------------------------------------------------------------------

# Website ID from Umami → Settings → Websites → <your site> (a UUID).
# This is the tracking credential embedded as `data-website-id` in the built
# HTML — it is not a secret (it ships in the public page source).
VITE_UMAMI_WEBSITE_ID=

# Umami instance URL (no trailing slash). Cloud: https://cloud.umami.is
# Self-hosted/local: http://localhost:3000
VITE_UMAMI_URL=
