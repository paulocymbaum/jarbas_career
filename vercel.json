{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/freelance", "destination": "/freelance.html" },
    { "source": "/freelance/", "destination": "/freelance.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
